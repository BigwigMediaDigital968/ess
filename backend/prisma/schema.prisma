generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  INDIVIDUAL_CONTRIBUTOR
  LEADERSHIP
  EXECUTIVE
  ADMINISTRATOR
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
}

enum AttendanceType {
  OFFICE
  WFH
  ONSITE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocType {
  ONBOARDING
  RESIGNATION
  DP
  OTHER
}

enum HolidayType {
  PUBLIC
  OPTIONAL
}

enum DocumentType {
  ONBOARDING
  RESIGNATION
  PROFILE_PIC
  EXPERIENCE_LETTER
  SALARY_SLIP
  RELIEVING_LETTER
  OTHER
}


model LeaveBalance {
  id             String @id @default(uuid())
  userId         String @unique
  user           User   @relation(fields: [userId], references: [id])
  casualLeaves   Float  @default(24) // Default from policy
  earnedLeaves   Float  @default(20)
  sickLeaves     Float  @default(10)
  year           Int    @default(2025)
  
  updatedAt      DateTime @updatedAt
}

model User {
  id                String       @id @default(uuid())
  employeeId        String?      @unique // Custom Employee ID (e.g. 001, 002)
  email             String       @unique
  password          String
  name              String
  
  // Relations
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  
  // Dynamic Role & Band
  roleId            String?
  role              Role?        @relation(fields: [roleId], references: [id])
  bandId            String?
  band              Band?        @relation(fields: [bandId], references: [id])

  LegacyRole        LegacyRole   @default(EMPLOYEE) // Keep for backward compatibility migration
  designation       String?
  profilePictureUrl String?
  bloodGroup        String?
  address           String?      // Keep for backward compatibility or map to presentAddress
  skills            String[]     // Keep for backward compatibility
  isActive          Boolean      @default(true)
  mustChangePassword Boolean     @default(true)
  passwordLastChangedAt DateTime @default(now())
  resetPasswordToken String?
  resetPasswordExpires DateTime?

  problemActivities ProblemActivity[]

  // Off-boarding fields
  exitDate          DateTime?
  exitReason        String?      // RESIGNATION, TERMINATION, RETIREMENT, CONTRACT_END, OTHER
  exitNotes         String?

  // New Onboarding Fields
  dob               DateTime?
  personalEmail     String?
  presentAddress    String?
  permanentAddress  String?
  latitude          Float?
  longitude         Float?
  
  // Onboarding Relations
  skillRecords      Skill[]
  certifications    Certification[]
  workExperience    WorkExperience[]
  departmentId      String?
  department        Department?  @relation(fields: [departmentId], references: [id])
  managerId         String?
  manager           User?        @relation("UserToManager", fields: [managerId], references: [id])
  subordinates      User[]       @relation("UserToManager")
  attendances       Attendance[]
  leaves            Leave[]
  wfhLocations      WFHLocation[]
  payrolls          Payroll[]
  reviews           Performance[] @relation("EmployeeReviews")
  
  // New Relations for Payroll & Rostering
  salaryStructure   SalaryStructure?
  payrollRecords    PayrollRecord[]
  rosters           Roster[]
  givenReviews      Performance[] @relation("ReviewerReviews")

  documents         Document[]
  
  // Chat Relations
  conversations     ConversationParticipant[]
  sentMessages      Message[]
  readMessages      MessageReadStatus[]

  leaveBalance      LeaveBalance?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  interviews        Interview[]

  // Appraisal Relations
  appraisalGoals        AppraisalGoal[]    @relation("EmployeeGoals")
  goalsSetByMe          AppraisalGoal[]    @relation("ManagerGoals")
  appraisalReviews      AppraisalReview[]  @relation("EmployeeReviews2")
  managedReviews        AppraisalReview[]  @relation("ManagerReviews2")

  // Change Management Relations
  implementedChanges    ChangeRequest[]    @relation("ChangeImplementer")
  changeApprovals       ChangeApproval[]

  // Asset Relations
  assets                Asset[]

  // Multi-Office Relations
  assignedOfficeId      String?
  assignedOffice        Office?            @relation(fields: [assignedOfficeId], references: [id])
  officeVisitRequests   OfficeVisitRequest[]
  managedOfficeVisits   OfficeVisitRequest[] @relation("ManagerApprovals")

  // Indian Payroll & Tax Compliance
  panNumber             String?   // PAN number e.g. ABCDE1234F
  ufn                   String?   // Unique File Number (Tax filings)
  bankName              String?
  bankAccountNumber     String?
  ifscCode              String?
  taxRegime             String?   @default("NEW") // NEW or OLD

  // Offboarding
  offboardingRequest    OffboardingRequest?

  // Service Desk Relations
  ticketsRaised         Ticket[]           @relation("TicketRequester")
  ticketsAssigned       Ticket[]           @relation("TicketAssignee")
}


enum LegacyRole {
  EMPLOYEE
  MANAGER
  HR
  ADMIN
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  address     String?
  website     String?  // Website URL
  contactEmail String? // Organization contact email
  gstNumber   String?  // GST registration number
  latitude    Float?
  longitude   Float?
  ownerId     String?  @unique // Ideally links to a User who is the Owner
  logoUrl     String?
  primaryColor   String?  @default("#a855f7") // Purple default
  accentColor    String?  @default("#ec4899") // Pink default
  themeMode      String?  @default("dark")    // "light", "dark", "system"
  loginBgUrl     String?  // Custom login background image/video URL
  loginBgType    String?  @default("gradient") // "gradient", "image", "video"
  configHrAccess Boolean @default(false)
  configDirectorAccess Boolean @default(false)
  users       User[]
  roles       Role[]
  bands       Band[]
  departments Department[]
  holidays    Holiday[]
  assets      Asset[]
  offices     Office[]

  leavePolicy LeavePolicy?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Role {
  id             String       @id @default(uuid())
  name           String       // e.g. "Software Engineer", "HR Manager", "Director"
  type           RoleType     @default(INDIVIDUAL_CONTRIBUTOR) 
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  users          User[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([name, organizationId])
}

model Band {
  id             String       @id @default(uuid())
  name           String       // e.g. "L1", "L2", "E1"
  level          Int          // Numeric level for hierarchy sorting
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  users          User[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([name, organizationId])
}

model LeavePolicy {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  casualLeaves   Int          @default(24)
  earnedLeaves   Int          @default(20)
  encashable     Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Holiday {
  id             String       @id @default(uuid())
  name           String
  date           DateTime
  type           HolidayType  @default(PUBLIC)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Department {
  id             String         @id @default(uuid())
  name           String
  description    String?
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  jobPostings    JobPosting[]
  
  // Change Management Relations
  changeRequests ChangeRequest[] @relation("ChangeGroup")
  problemGroups    Problem[]            @relation("ProblemAssignmentGroup")
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([name, organizationId])
}

model Office {
  id             String       @id @default(uuid())
  address        String?
  latitude       Float
  longitude      Float
  radius         Float        @default(200) // acceptable check-in radius in meters
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  users               User[]
  assets              Asset[]
  attendances         Attendance[]
  officeVisitRequests OfficeVisitRequest[]  @relation("TargetOffice")
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model OfficeVisitRequest {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  targetOfficeId String
  targetOffice   Office        @relation("TargetOffice", fields: [targetOfficeId], references: [id])
  date           DateTime      @db.Date
  status         RequestStatus @default(PENDING)
  managerId      String?
  manager        User?         @relation("ManagerApprovals", fields: [managerId], references: [id])
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Attendance {
  id        String   @id @default(uuid())
  date      DateTime
  clockIn   DateTime
  clockOut  DateTime?
  status    AttendanceStatus
  type      AttendanceType @default(OFFICE)
  latitude  Float?
  longitude Float?
  address   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  officeId  String?
  office    Office?  @relation(fields: [officeId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Leave {
  id        String      @id @default(uuid())
  type      LeaveType
  startDate DateTime
  endDate   DateTime
  reason    String
  status    LeaveStatus @default(PENDING)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  approverId String?    // ID of the manager who approved/rejected
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model WFHLocation {
  id        String   @id @default(uuid())
  address   String
  latitude  Float
  longitude Float
  status    LeaveStatus @default(PENDING)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payroll {
  id          String   @id @default(uuid())
  month       Int
  year        Int
  basicSalary Float
  allowances  Float
  deductions  Float
  netPay      Float
  status      String   @default("PROCESSED")
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Performance {
  id          String   @id @default(uuid())
  period      String   // e.g. "Q1 2024"
  rating      Float // 1-5
  feedback    String
  goals       Json?
  reviewerId  String
  reviewer    User     @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  userId      String
  user        User     @relation("EmployeeReviews", fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Document {
  id        String   @id @default(uuid())
  name      String
  url       String
  type      DocumentType
  workExperienceId String?
  workExperience   WorkExperience? @relation(fields: [workExperienceId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Chat Models
model Conversation {
  id        String   @id @default(uuid())
  name      String?
  type      ConversationType @default(DIRECT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  participants ConversationParticipant[]
  messages Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  joinedAt       DateTime     @default(now())
  
  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String?
  type           MessageType  @default(TEXT)
  fileUrl        String?
  approvalStatus ApprovalStatus?
  referenceId    String?      // Links to Leave ID, WFH ID, etc.
  createdAt      DateTime     @default(now())
  readStatus     MessageReadStatus[]
}

model MessageReadStatus {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
}

// --- PAYROLL & SALARY ---

model SalaryStructure {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  
  // Earnings
  basic            Float    @default(0)
  hra              Float    @default(0)
  da               Float    @default(0) // Dearness Allowance
  travelAllowance  Float    @default(0)
  medicalAllowance Float    @default(0)
  specialAllowance Float    @default(0)
  bonus            Float    @default(0)
  
  // CTC (source of truth)
  ctcAnnual        Float?   // Annual CTC offered during onboarding
  
  // Deductions Config (Standard rates or fixed amounts)
  pfConfig         String   @default("STANDARD_12") // STANDARD_12, FIXED_AMOUNT, NONE
  pfFixedAmount    Float    @default(0)
  ptConfig         String   @default("STANDARD_STATE") // STANDARD_STATE, NONE
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PayrollRecord {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  
  month           Int
  year            Int
  
  // Usage Stats
  totalDays       Int
  workingDays     Int
  presentDays     Float
  paidLeaves      Float
  lopDays         Float
  
  // Financials
  grossEarnings   Float
  totalDeductions Float
  netPay          Float
  
  // Detailed Components (Snapshot)
  basic           Float
  hra             Float
  da              Float
  allowances      Float
  
  pfEmployee      Float
  pfEmployer      Float
  professionalTax Float
  tds             Float
  otherDeductions Float
  
  // Waiver Logic
  isLopWaived     Boolean  @default(false)
  waiverReason    String?
  waivedBy        String?  // Name/ID of approver
  
  status          String   @default("DRAFT") // DRAFT, PROCESSED, PAID
  generatedAt     DateTime @default(now())
  
  @@unique([userId, month, year])
}

// --- ROSTERING ---

model Shift {
  id        String   @id @default(uuid())
  name      String   // e.g., "General", "Morning", "Night"
  startTime String   // "09:00"
  endTime   String   // "18:00"
  
  // Break info could be added
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  rosters   Roster[]
}

model Roster {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  date      DateTime @db.Date // Specific date
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id])
  
  assignedBy String? // Manager ID
  createdAt  DateTime @default(now())
  
  @@unique([userId, date])
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  APPROVAL_REQUEST
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkLocation {
  REMOTE
  OFFICE
  CLIENT
}

// --- ONBOARDING MODELS ---

model Skill {
  id              String   @id @default(uuid())
  name            String
  experienceYears Float?
  rating          Float?   // 1-5
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Certification {
  id              String   @id @default(uuid())
  name            String
  issuingOrg      String
  credentialUrl   String?
  issueDate       DateTime?
  expiryDate      DateTime?
  imageUrl        String?  // Badge image URL
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WorkExperience {
  id              String   @id @default(uuid())
  companyName     String
  designation     String
  startDate       DateTime
  endDate         DateTime?
  description     String?
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  documents       Document[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --- TALENT ACQUISITION SYSTEM (TAS) MODELS ---

enum JobStatus {
  OPEN
  CLOSED
  DRAFT
  HOLD
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  ASSESSMENT
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum AssessmentType {
  TECHNICAL
  BEHAVIORAL
  CODING
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OfferStatus {
  GENERATED
  SENT
  ACCEPTED
  REJECTED
}

model JobPosting {
  id          String   @id @default(uuid())
  title       String
  description String
  requirements String? 
  departmentId String?
  department  Department? @relation(fields: [departmentId], references: [id])
  location    String?
  type        String? // Full-time, Contract
  salaryRange String?
  status      JobStatus @default(OPEN)
  postedBy    String? // User ID of HR/Manager
  
  applications Application[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Candidate {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String   @unique
  phone       String?
  resumeUrl   String?
  skills      String[] // Parsed skills
  experienceYears Float?
  
  applications Application[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Application {
  id          String            @id @default(uuid())
  jobId       String
  job         JobPosting        @relation(fields: [jobId], references: [id])
  candidateId String
  candidate   Candidate         @relation(fields: [candidateId], references: [id])
  status      ApplicationStatus @default(APPLIED)
  aiScore     Float?            // calculated matchmaking score
  
  assessments Assessment[]
  interviews  Interview[]
  offers      Offer[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Assessment {
  id            String         @id @default(uuid())
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id])
  type          AssessmentType
  questions     Json?          // AI generated questions
  responses     Json?          // Candidate answers
  score         Int?
  analysisReport String? // AI generated feedback
  status        String   @default("PENDING") // PENDING, COMPLETED, REVIEWED 
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Interview {
  id            String          @id @default(uuid())
  applicationId String
  application   Application     @relation(fields: [applicationId], references: [id])
  interviewerId String
  interviewer   User            @relation(fields: [interviewerId], references: [id])
  round         String          // "Technical 1", "Managerial"
  scheduledAt   DateTime
  feedback      String?
  rating        Float?
  status        InterviewStatus @default(SCHEDULED)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Offer {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  basicSalary   Float
  allowances    Float
  joiningDate   DateTime
  status        OfferStatus @default(GENERATED)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Appraisal Cycle ──────────────────────────────────────────────────────────

model AppraisalCycle {
  id          String          @id @default(uuid())
  quarter     Int             // 1-4
  year        Int
  status      AppraisalStatus @default(OPEN)
  phase       String          @default("GOAL_SETTING") // GOAL_SETTING | GOALS_APPROVED | SELF_REVIEW | MANAGER_REVIEW | HR_FINAL | COMPLETED
  goals       AppraisalGoal[]
  reviews     AppraisalReview[]
  teamBudgets TeamBudget[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([quarter, year])
}

model AppraisalGoal {
  id                  String         @id @default(uuid())
  cycleId             String
  cycle               AppraisalCycle @relation(fields: [cycleId], references: [id])
  userId              String
  user                User           @relation("EmployeeGoals", fields: [userId], references: [id])
  setById             String
  setBy               User           @relation("ManagerGoals", fields: [setById], references: [id])
  title               String
  description         String?
  kraCategory         String?        // e.g. "Delivery", "Quality", "Innovation"
  weight              Float          @default(100)
  status              GoalStatus     @default(PENDING)
  hrApproved          Boolean        @default(false)
  // Employee Goal Acceptance
  acceptedByEmployee  Boolean        @default(false)
  employeeConcern     String?        // Concern raised by employee
  acceptedAt          DateTime?
  // Self Review (per goal)
  selfRating          Float?         // 1-5 stars
  selfComment         String?
  selfAttachmentUrl   String?
  selfSubmittedAt     DateTime?
  // Manager Review (per goal)
  managerRating       Float?         // 1-5 stars
  managerComment      String?
  managerReviewedAt   DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model AppraisalReview {
  id              String         @id @default(uuid())
  cycleId         String
  cycle           AppraisalCycle @relation(fields: [cycleId], references: [id])
  userId          String
  user            User           @relation("EmployeeReviews2", fields: [userId], references: [id])
  managerId       String?
  manager         User?          @relation("ManagerReviews2", fields: [managerId], references: [id])

  // Self Assessment
  selfRating      Float?         // 1-5
  selfComment     String?
  selfSubmittedAt DateTime?

  // Manager Assessment
  managerRating   Float?         // 1-5
  managerComment  String?
  managerApproved Boolean        @default(false)
  managerReviewedAt DateTime?

  // Annual / Final (Q4)
  annualSelfRating    Float?         // Employee's Q4 annual self-rating
  managerFinalRating  Float?         // Manager's final annual rating (step 9)
  finalApprovedBy     String?        // Owner/Admin/HR user ID who approved
  finalApprovedAt     DateTime?
  letterSentAt        DateTime?      // When appraisal letter was generated

  // HR / Final
  finalRating     Float?         // Computed: avg of 4 quarters
  salaryHike      Float?         // % hike
  hikeAmount      Float?         // Absolute ₹ amount
  newCTC          Float?         // Revised annual CTC post appraisal
  hrApproved      Boolean        @default(false)
  publishedAt     DateTime?
  pdfUrl          String?        // Appraisal letter PDF path

  status          ReviewStatus   @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([cycleId, userId])
}

// ─── Offboarding ─────────────────────────────────────────────────────────────

model OffboardingRequest {
  id                  String    @id @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id])
  lastDay             DateTime
  reason              String?
  initiatedBy         String    @default("SELF") // SELF | HR
  managerApprovedAt   DateTime?
  itClearedAt         DateTime?
  hrApprovedAt        DateTime?
  status              String    @default("PENDING") // PENDING | MANAGER_APPROVED | IT_CLEARED | HR_APPROVED | COMPLETED
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ─── Appraisal Budget & Hike ─────────────────────────────────────────────────

model TeamBudget {
  id             String         @id @default(uuid())
  cycleId        String
  cycle          AppraisalCycle @relation(fields: [cycleId], references: [id])
  managerId      String
  departmentId   String?
  totalBudget    Float          // ₹ allocated by Owner
  usedBudget     Float          @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([cycleId, managerId])
}

model HikeAllocation {
  id            String    @id @default(uuid())
  cycleId       String
  userId        String
  managerId     String
  hikePercent   Float
  hikeAmount    Float
  newCTC        Float
  effectiveDate DateTime?
  approvedAt    DateTime?
  pdfUrl        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([cycleId, userId])
}

enum AppraisalStatus {
  OPEN
  SELF_ASSESSMENT
  MANAGER_REVIEW
  HR_REVIEW
  PUBLISHED
}

enum GoalStatus {
  PENDING
  ACHIEVED
  PARTIAL
  MISSED
}

enum ReviewStatus {
  PENDING
  SELF_DONE
  MANAGER_DONE
  HR_APPROVED
  PUBLISHED
}

// ─── Asset Management ─────────────────────────────────────────────────────────

enum AssetCategory {
  LAPTOP
  DESKTOP
  SERVER
  WIRED_KEYBOARD
  WIRED_MOUSE
  WIRELESS_KEYBOARD
  WIRELESS_MOUSE
  WEBCAM
  DOCKING_STATION
  MONITOR
  NETWORK_SWITCH
  FIREWALL
  ROUTER
  OTHER
}

enum AssetStatus {
  IN_STOCK
  POPS
  ASSIGNED
  RETIRED
}

model Asset {
  id             String        @id @default(uuid())
  serialNumber   String        @unique
  name           String
  category       AssetCategory @default(OTHER)
  status         AssetStatus   @default(IN_STOCK)
  configuration  Json?
  warrantyExpiry DateTime?
  assetId        String?       @unique
  
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  
  officeId       String?
  office         Office?       @relation(fields: [officeId], references: [id])
  
  assignedToId   String?
  assignedTo     User?         @relation(fields: [assignedToId], references: [id])
  
  qrCodeUrl      String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// ─── SERVICE DESK / ITSM ──────────────────────────────────────────────────────

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  WAITING_FOR_USER
  PENDING_VENDOR
  PENDING_OTHER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketType {
  INCIDENT
  SERVICE_REQUEST
}

enum ChangeStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  IMPLEMENTING
  IMPLEMENTED
  PIR_PENDING
  CLOSED
}

enum ChangeRisk {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ChangeType {
  STANDARD
  NORMAL
  EMERGENCY
}

enum ChangeImpact {
  LOW
  MEDIUM
  HIGH
}

enum ChangeUrgency {
  LOW
  MEDIUM
  HIGH
}

enum ProblemStatus {
  OPEN
  UNDER_INVESTIGATION
  ROOT_CAUSE_IDENTIFIED
  KNOWN_ERROR
  CLOSED
}

enum CMDBItemType {
  SERVER
  VM
  DATABASE
  APPLICATION
  NETWORK
  ENDPOINT
  SERVICE
  STORAGE
  OTHER
}

enum CMDBItemStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

enum CMDBEnvironment {
  PROD
  UAT
  DEV
  DR
  STAGING
}

enum CMDBRelationshipType {
  DEPENDS_ON
  HOSTS
  RUNS_ON
  CONNECTS_TO
  BACKED_UP_BY
  PART_OF
}

// SLA Policy
model SLAPolicy {
  id                    String         @id @default(uuid())
  name                  String
  priority              TicketPriority
  ticketType            TicketType
  responseTimeMinutes   Int
  resolutionTimeMinutes Int
  isActive              Boolean        @default(true)
  organizationId        String
  tickets               Ticket[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

// Service Desk Team
model ServiceDeskTeam {
  id             String                @id @default(uuid())
  name           String
  description    String?
  organizationId String
  members        ServiceDeskMember[]
  categories     TicketCategoryModel[]
  tickets        Ticket[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([name, organizationId])
}

model ServiceDeskMember {
  id     String          @id @default(uuid())
  teamId String
  team   ServiceDeskTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  isLead Boolean         @default(false)

  @@unique([teamId, userId])
}

// Ticket Category
model TicketCategoryModel {
  id             String           @id @default(uuid())
  name           String
  ticketType     TicketType       @default(INCIDENT)
  teamId         String?
  team           ServiceDeskTeam? @relation(fields: [teamId], references: [id])
  organizationId String
  tickets        Ticket[]
  problems       Problem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([name, organizationId])
}

// Main Ticket
model Ticket {
  id               String               @id @default(uuid())
  ticketNumber     String               @unique
  title            String
  description      String
  type             TicketType           @default(INCIDENT)
  status           TicketStatus         @default(OPEN)
  priority         TicketPriority       @default(MEDIUM)

  requesterId      String
  requester        User                 @relation("TicketRequester", fields: [requesterId], references: [id])

  assigneeId       String?
  assignee         User?                @relation("TicketAssignee", fields: [assigneeId], references: [id])
  teamId           String?
  team             ServiceDeskTeam?     @relation(fields: [teamId], references: [id])

  categoryId       String?
  category         TicketCategoryModel? @relation(fields: [categoryId], references: [id])
  slaId            String?
  sla              SLAPolicy?           @relation(fields: [slaId], references: [id])
  slaResponseDue   DateTime?
  slaResolutionDue DateTime?
  slaBreached      Boolean              @default(false)

  ciId             String?
  ci               CMDBItem?            @relation(fields: [ciId], references: [id])

  problemId        String?
  problem          Problem?             @relation(fields: [problemId], references: [id])
  changeRequestId  String?
  changeRequest    ChangeRequest?       @relation(fields: [changeRequestId], references: [id])

  resolvedAt       DateTime?
  closedAt         DateTime?
  resolution       String?

  comments         TicketComment[]
  activities       TicketActivity[]
  attachmentUrls   String[]             @default([])

  organizationId   String

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model TicketComment {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TicketActivity {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String
  action    String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
}

// Change Request (RFC)
model ChangeRequest {
  id             String          @id @default(uuid())
  changeNumber   String          @unique
  title          String
  description    String
  risk           ChangeRisk      @default(LOW)
  status         ChangeStatus    @default(DRAFT)
  
  type           ChangeType      @default(NORMAL)
  impact         ChangeImpact    @default(LOW)
  urgency        ChangeUrgency   @default(LOW)

  justification      String?
  implementationPlan String?
  testPlan           String?

  requesterId    String
  approvedById   String?

  cabMeetingDate DateTime?
  plannedStart   DateTime?
  plannedEnd     DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  rollbackPlan   String?
  pirNotes       String?

  linkedTickets  Ticket[]
  linkedCIs      ChangeRequestCI[]
  comments       ChangeComment[]
  
  attachmentUrls String[]             @default([])
  assignmentGroupId String?
  assignmentGroup   Department?       @relation("ChangeGroup", fields: [assignmentGroupId], references: [id])
  implementerId     String?
  implementer       User?             @relation("ChangeImplementer", fields: [implementerId], references: [id])
  approvers         ChangeApproval[]
  activities        ChangeActivity[]

  organizationId String

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ChangeRequestCI {
  id              String        @id @default(uuid())
  changeRequestId String
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  ciId            String
  ci              CMDBItem      @relation(fields: [ciId], references: [id])

  @@unique([changeRequestId, ciId])
}

model ChangeComment {
  id              String        @id @default(uuid())
  changeRequestId String
  change          ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  authorId        String
  body            String
  createdAt       DateTime      @default(now())
}

model ChangeApproval {
  id              String        @id @default(uuid())
  changeRequestId String
  change          ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  approverId      String
  approver        User          @relation(fields: [approverId], references: [id])
  status          RequestStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([changeRequestId, approverId])
}

model ChangeActivity {
  id              String        @id @default(uuid())
  changeRequestId String
  change          ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  actorId         String
  action          String
  oldValue        String?
  newValue        String?
  createdAt       DateTime      @default(now())
}

// Problem Record
model Problem {
  id               String           @id @default(uuid())
  problemNumber    String           @unique
  title            String
  description      String
  status           ProblemStatus    @default(OPEN)

  impact           TicketPriority  @default(LOW)
  urgency          TicketPriority  @default(LOW)
  priority         TicketPriority  @default(LOW)

  categoryId       String?
  category         TicketCategoryModel?  @relation(fields: [categoryId], references: [id])

  assignmentGroupId String?
  assignmentGroup  Department?      @relation("ProblemAssignmentGroup", fields: [assignmentGroupId], references: [id])
  assigneeId       String?

  attachmentUrls   String[]         @default([])

  rootCause        String?
  workaround       String?

  linkedIncidents  Ticket[]
  kedbEntry        KEDBEntry?
  activities       ProblemActivity[]

  organizationId   String

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProblemActivity {
  id               String           @id @default(uuid())
  problemId        String
  problem          Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  actorId          String
  actor            User?            @relation(fields: [actorId], references: [id])
  action           String
  oldValue         String?
  newValue         String?
  createdAt        DateTime         @default(now())
}

// Known Error Database
model KEDBEntry {
  id             String   @id @default(uuid())
  title          String
  symptoms       String
  rootCause      String
  workaround     String
  resolution     String?
  articleUrl     String?

  problemId      String?  @unique
  problem        Problem? @relation(fields: [problemId], references: [id])

  createdById    String
  organizationId String

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// CMDB – Configuration Item
model CMDBItem {
  id              String            @id @default(uuid())
  ciNumber        String            @unique
  name            String
  type            CMDBItemType      @default(SERVER)
  status          CMDBItemStatus    @default(ACTIVE)
  environment     CMDBEnvironment   @default(PROD)

  ownerId         String?
  managedById     String?
  ipAddress       String?
  hostName        String?
  location        String?
  description     String?
  attributes      Json?

  relationsAsSource CMDBRelationship[]  @relation("SourceCI")
  relationsAsTarget CMDBRelationship[]  @relation("TargetCI")

  tickets           Ticket[]
  changeRequests    ChangeRequestCI[]

  organizationId  String

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model CMDBRelationship {
  id               String               @id @default(uuid())
  sourceId         String
  source           CMDBItem             @relation("SourceCI", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId         String
  target           CMDBItem             @relation("TargetCI", fields: [targetId], references: [id], onDelete: Cascade)
  relationshipType CMDBRelationshipType @default(DEPENDS_ON)
  createdAt        DateTime             @default(now())

  @@unique([sourceId, targetId, relationshipType])
}

// Auto-incrementing counters for ticket/change/problem/CI numbers
model ServiceDeskCounter {
  id      String @id @default(uuid())
  prefix  String @unique
  current Int    @default(0)
}
