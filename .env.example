# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=ess_db

# ─── Backend ──────────────────────────────────────────────────────────────────
NODE_ENV=production
JWT_SECRET=your_very_long_random_jwt_secret_here
PORT=3434

# OIDC Issuer URL (must match what Nextcloud is configured to use)
OIDC_ISSUER=http://your-domain.com

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://your-domain.com/api

# ─── Nextcloud ────────────────────────────────────────────────────────────────
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=changeme_in_production
